# ============================================================
# data-pipeline 数据处理服务 - 环境变量配置模板
# 复制为 .env 并填入实际值；敏感信息严禁硬编码到业务代码
# ============================================================

# -------------------- 服务端口 --------------------
PORT=3002

# -------------------- 服务间认证与 CORS --------------------
# 生产环境必填，Java Backend / Agent Gateway 调用时使用 Bearer Token
PIPELINE_SERVICE_TOKEN=
PIPELINE_ALLOWED_ORIGINS=http://localhost:5173

# -------------------- Embedding 向量模型（OpenAI 兼容接口，可切换） --------------------
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# -------------------- ChromaDB 向量数据库 --------------------
CHROMADB_URL=http://localhost:8000
CHROMADB_COLLECTION=customer_service_knowledge

# -------------------- 分块策略 --------------------
# 可选: pdr | recursive
CHUNKING_STRATEGY=pdr
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# 父文档检索（PDR）父子层级
PDR_PARENT_CHUNK_SIZE=2000
PDR_PARENT_OVERLAP=200
PDR_CHILD_CHUNK_SIZE=400
PDR_CHILD_OVERLAP=50

# -------------------- 检索配置 --------------------
SEARCH_LIMIT=5

# -------------------- 日志级别 --------------------
# debug | info | warn | error
LOG_LEVEL=info
