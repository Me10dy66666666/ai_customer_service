<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.infrastructure.persistence.mapper.WorkOrderTransferLogMapper">
    <resultMap id="BaseResultMap" type="com.example.backend.infrastructure.persistence.entity.WorkOrderTransferLog">
        <id column="id" property="id"/>
        <result column="work_order_id" property="workOrderId"/>
        <result column="from_handler_id" property="fromHandlerId"/>
        <result column="to_handler_id" property="toHandlerId"/>
        <result column="transfer_reason" property="transferReason"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO work_order_transfer_log (work_order_id, from_handler_id, to_handler_id, transfer_reason)
        VALUES (#{workOrderId}, #{fromHandlerId}, #{toHandlerId}, #{transferReason})
    </insert>
    <select id="findByWorkOrderId" resultMap="BaseResultMap">
        SELECT * FROM work_order_transfer_log WHERE work_order_id = #{workOrderId} ORDER BY create_time ASC
    </select>
</mapper>
