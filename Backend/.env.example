# Spring Boot runtime configuration template.
# Inject these variables through the process/container environment; Spring does not
# automatically load this file from the repository.

# Required security and business database settings
JWT_SECRET=
DB_URL=jdbc:mysql://localhost:3306/ai_customer_service?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Agent runtime: dsh is the production default
AGENT_PROVIDER=dsh
DSH_GATEWAY_BASE_URL=http://localhost:3001
DSH_GATEWAY_SERVICE_TOKEN=
DSH_GATEWAY_MODEL=deepseek-v4-pro

# Optional Dify fallback/gray route
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_CHAT_KEY=
DIFY_KNOWLEDGE_KEY=
DIFY_DATASET_ID=
DIFY_INTERVENTION_KEY=
DIFY_WORKORDER_KEY=
DSH_GRAY_PERCENTAGE=0

# Shared platform services
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
ELASTICSEARCH_URIS=http://127.0.0.1:9200
