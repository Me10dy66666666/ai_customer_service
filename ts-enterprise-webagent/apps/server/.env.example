# ============================================================
# Agent 智能客服系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 敏感信息集中管理，严禁在业务代码中硬编码
# ============================================================

# -------------------- 服务端口 --------------------
PORT=3001

# -------------------- 模型模式 --------------------
# 可选: mock | openai-compatible | dify；生产请显式使用 openai-compatible 或 dify
AGENT_MODEL_MODE=openai-compatible

# -------------------- OpenAI / 兼容接口 --------------------
# LLM 大模型
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Embedding 由 data-pipeline 统一完成
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# -------------------- PostgreSQL + pgvector 数据管道 --------------------
DATA_PIPELINE_URL=http://localhost:3002
PIPELINE_SERVICE_TOKEN=
DATA_PIPELINE_TIMEOUT_MS=15000
DATA_PIPELINE_RETRY_ATTEMPTS=2
DATA_PIPELINE_RETRY_DELAY_MS=250

# -------------------- Dify 平台 --------------------
# Dify 平台基础 URL
DIFY_BASE_URL=https://api.dify.ai/v1
# Dify Chat API 密钥（用于智能客服对话）
DIFY_CHAT_API_KEY=
# Dify 知识库 API 密钥（用于知识库文档上传/管理）
DIFY_KNOWLEDGE_API_KEY=
# Dify 数据集 ID（对应 Dify 平台的知识库 ID）
DIFY_DATASET_ID=
# Dify 转人工干预工作流 API 密钥
DIFY_INTERVENTION_API_KEY=
# Dify 工单分析工作流 API 密钥
DIFY_WORKORDER_API_KEY=
# Dify 工作流端点路径
DIFY_TRANSFER_WORKFLOW_ENDPOINT=/workflows/run
DIFY_WORKORDER_WORKFLOW_ENDPOINT=/workflows/run

# -------------------- CORS --------------------
ALLOWED_ORIGINS=http://localhost:5173

# -------------------- 知识库配置 --------------------
KNOWLEDGE_SEARCH_LIMIT=5
KNOWLEDGE_CACHE_TTL_SECONDS=3600

# -------------------- Agent 会话配置 --------------------
SESSION_TTL_SECONDS=86400
MAX_CONCURRENT_AGENTS=10

# -------------------- 日志级别 --------------------
# debug | info | warn | error
LOG_LEVEL=info
