APP_ENV=development
LOG_LEVEL=INFO

# Chat model used by the optional LangChain workflow.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=Deepseek-V4-Flash
OPENAI_TEMPERATURE=0.2

# Canonical knowledge service; PostgreSQL + pgvector are owned by data-pipeline.
DATA_PIPELINE_URL=http://localhost:3002
PIPELINE_SERVICE_TOKEN=
VECTOR_DATASET_ID=default
VECTOR_TIMEOUT_MS=5000
VECTOR_RETRY_ATTEMPTS=2
VECTOR_RETRY_DELAY_MS=200

# MySQL source used only by the one-time knowledge ingestion command.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=ai_customer_service
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600
